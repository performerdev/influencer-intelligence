# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_DISTILL=deepseek-v4-pro
LLM_MODEL_CHAT=deepseek-v4-pro
TWITTERAPI_IO_KEY=
# Supabase → Connect → Direct → Session pooler (IPv4), port 5432
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Same host, transaction pooler port 6543 — for Netlify functions
DATABASE_URL_POOLED=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Historical prices: DefiLlama coins API (free, no key)
PRICE_API_BASE=https://coins.llama.fi
